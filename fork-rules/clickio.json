{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "clickio": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cl-consent"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".cl-consent__inner"
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".cl-consent__btn--outline"
                    }
                },
                "name": "OPEN_OPTIONS"
            },
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "foreach",
                            "target": {
                                "selector": ".cl-consent-tabs__item"
                            },
                            "action": {
                                "type": "list",
                                "actions": [
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Archiviare e/o accedere a informazioni su un dispositivo",
                                                "Store and/or access information on a device"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "D",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Selezionare annunci basici (basic ads)",
                                                "Creare un profilo di annunci personalizzati",
                                                "Selezionare annunci personalizzati",
                                                "Pubblicare tecnicamente annunci o contenuti",
                                                "Use limited data to select advertising",
                                                "Create profiles for personalised advertising",
                                                "Use profiles to select personalised advertising",
                                                "Measure advertising performance"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "F",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Creare un profilo di contenuto personalizzato",
                                                "Selezionare contenuti personalizzati",
                                                "Create profiles to personalise content",
                                                "Use profiles to select personalised content",
                                                "Measure content performance"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "E",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Valutare le performance degli annunci",
                                                "Valutare le performance dei contenuti",
                                                "Applicare ricerche di mercato per generare approfondimenti sul pubblico",
                                                "Understand audiences through statistics or combinations of data from different sources",
                                                "Use limited data to select content",
                                                "Match and combine data from other data sources"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "B",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Scansione attiva delle caratteristiche del dispositivo ai fini dell’identificazione",
                                                "Ricevere e usare le caratteristiche che il dispositivo invia automaticamente ai fini dell’identificazione",
                                                "Use precise geolocation data",
                                                "Actively scan device characteristics for identification",
                                                "Identify devices based on information transmitted automatically"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "D",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Sviluppare e perfezionare i prodotti",
                                                "Utilizzare dati di geolocalizzazione precisi",
                                                "Garantire la sicurezza, prevenire frodi e debug",
                                                "Abbinare e combinare fonti di dati offline",
                                                "Collegare diversi dispositivi",
                                                "Develop and improve services",
                                                "Ensure security, prevent and detect fraud, and fix errors"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "X",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ".cl-consent-node-h4",
                                            "textFilter": [
                                                "Link different devices"
                                            ]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "type": "A",
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": ".cl-consent-node-input"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "[title*='legit' i], [title*='berechtigt' i], [title*='gerechtvaardigd' i], [title*='uzasadnion' i], [title*='законн' i], [title*='berettiget' i], [title*='berättigat' i], [title*='oikeutettu' i], [title*='oprávněn' i], [title*='jogos érdek' i], [title*='έννομο' i], [title*='meşru' i]"
                            }
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": ".cl-consent-tabs__content.cl-consent-active [data-role='alloff']"
                            }
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "[title*='partner' i], [title*='partenair' i], [title*='socio' i], [title*='parceiro' i], [title*='партн' i], [title*='fornitor' i], [title*='anbieter' i], [title*='leverancier' i], [title*='dostawc' i], [title*='vendor' i]"
                            }
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": ".cl-consent-tabs__content.cl-consent-active [data-role='alloff']"
                            }
                        }
                    ]
                },
                "name": "DO_CONSENT"
            },
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": ".cl-consent__btn.cl-consent__btn--outline.cl-consent-node-a"
                            },
                            "parent": {
                                "selector": ".cl-consent__buttons--three-btns",
                                "textFilter": [
                                    "Salva impostazioni",
                                    "Accetta selezionati",
                                    "Agree to selected"
                                ]
                            }
                        }
                    ]
                },
                "name": "SAVE_CONSENT"
            },
            {
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cl-consent"
                            }
                        }
                    ]
                },
                "name": "HIDE_CMP"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}